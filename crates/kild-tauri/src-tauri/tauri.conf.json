{
    "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
    "productName": "KILD",
    "version": "0.1.0",
    "identifier": "com.kild.tauri",
    "build": {
        "frontendDist": "../dist",
        "devUrl": "http://localhost:1420",
        "beforeDevCommand": "npm run dev",
        "beforeBuildCommand": "npm run build"
    },
    "app": {
        "macOSPrivateApi": true,
        "windows": [
            {
                "title": "KILD",
                "width": 900,
                "height": 650,
                "minWidth": 600,
                "minHeight": 400,
                "decorations": true,
                "resizable": true,
                "titleBarStyle": "Overlay",
                "hiddenTitle": true,
                "transparent": true,
                "theme": "Dark"
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/icon.icns",
            "icons/icon.png"
        ]
    }
}